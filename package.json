{
  "name": "deep-projects",
  "version": "0.4.10",
  "description": "Claude-Desktop-style Projects for DeepSeek Harness (dsh): named rooms in the sidebar, each with a goal, custom instructions, knowledge files and a memory your agents keep up to date, so you never explain a project twice.",
  "icon": "./icon.svg",
  "homepage": "https://joblessjoe.com/deep-projects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoblessJoe/deep-projects.git"
  },
  "bugs": {
    "url": "https://github.com/JoblessJoe/deep-projects/issues"
  },
  "author": "Johannes Tebbert <info@joblessjoe.com> (https://joblessjoe.com)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1 <0.4.0-0"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Projects",
    "summary": "Claude-Desktop-style Projects: sidebar rooms with a goal, instructions (AGENTS.md), knowledge files and agent-maintained memory, auto-loaded into every chat.",
    "categories": [
      "Productivity",
      "Web UI"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "compatibility": {
      "dsh": ">=0.2.2-rc.1 <0.4.0-0",
      "node": ">=20"
    },
    "permissions": {}
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "projects",
    "workspaces",
    "claude",
    "memory",
    "context",
    "agents-md",
    "knowledge",
    "项目管理",
    "工作区",
    "dsh插件"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.4.0-0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
